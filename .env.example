# ============================================================
#  复制本文件为 .env，填入你的真实 Key
#  .env 已在 .gitignore 里忽略，不会被提交（密钥泄露是很严重的事故）
#
#  命令：copy .env.example .env      （Windows CMD）
#       cp .env.example .env        （Git Bash）
# ============================================================

# ---------- 大模型配置（生成答案用） ----------
# 你的 Key，sk- 开头
API_KEY=sk-your-key-here

# 服务地址。DeepSeek 官方就是这个
BASE_URL=https://api.deepseek.com

# 模型名。deepseek-chat 便宜够用
MODEL=deepseek-chat

# ---------- 检索参数（第 2 阶段会用到，先给你留好） ----------
# 切块时每块大概多少字符
CHUNK_SIZE=500

# 相邻块之间重叠多少字符（防止一句话被切断后两边都查不到）
CHUNK_OVERLAP=80

# 每次检索取前几段送给大模型（送太多会超长度限制、也费钱）
TOP_K=3
